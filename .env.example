# ---- Database ----
# host "db" only resolves inside docker-compose's network. Running the API
# directly on your machine (not via docker-compose)? Use localhost instead.
DATABASE_URL=postgresql://peblo:peblo@db:5432/peblo

# ---- Storage ----
# "local" for dev/CI (writes to disk, served via /static).
# "r2" for Cloudflare R2 / any S3-compatible bucket in production.
STORAGE_BACKEND=local
# /data/storage is a path *inside the api container*, backed by the
# api_storage volume in docker-compose.yml — leave as-is unless you also
# change that volume mount.
STORAGE_LOCAL_PATH=/data/storage
STORAGE_PUBLIC_BASE_URL=http://localhost:8000/static

# only read when STORAGE_BACKEND=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=peblo-tv
R2_PUBLIC_BASE_URL=

# ---- Auth ----
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ---- Reference data ----
# /data/reference.json is inside the api container, mounted read-only from
# ./data on the host (see the api service's volumes: in docker-compose.yml).
REFERENCE_JSON_PATH=/data/reference.json

# ---- Frontends (build-time, passed as docker build args) ----
VITE_API_BASE_URL=http://localhost:8000
